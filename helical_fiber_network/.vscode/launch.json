{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1 Generate synthetic data",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/generate_data.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [],
      "justMyCode": true
    },
    {
      "name": "2 Train joint network",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/train.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
