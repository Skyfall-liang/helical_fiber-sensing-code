      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--split",
        "test"
      ],
      "justMyCode": true
    },
    {
      "name": "4 Predict real bending + contact",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/predict.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [],
      "justMyCode": true
    },
    {
      "name": "5 Predict synthetic pure contact",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/predict.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--input",
        "data/synthetic/example_pure_contact.csv",
